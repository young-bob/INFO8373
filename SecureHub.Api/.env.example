# ---------------------------------------------------------
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDERS WITH REAL VALUES
# ---------------------------------------------------------

# AES-256 Encryption Key Base64 (Must be exactly 32 bytes)
# For example: AES_ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
AES_ENCRYPTION_KEY="<INSERT_BASE64_32_BYTE_KEY_HERE>"

# Database Connection (SQLite local path by default)
DB_CONNECTION_STRING="Data Source=Data/app.db"

# JWT Secrets for Authentication
# For example: JWT_SECRET="DevelopmentSuperSecretJwtKeyRequiredForSigningRequests!"
JWT_SECRET="<INSERT_STRONG_JWT_SECRET_HERE>"
# For example: JWT_ISSUER="SecureHub"
JWT_ISSUER="<INSERT_ISSUER_NAME>"

# For example: JWT_AUDIENCE="SecureHubClient"
JWT_AUDIENCE="<INSERT_AUDIENCE_NAME>"

# Default Admin Account (Auto-seeded on first run if DB is empty)
# For example: DEFAULT_ADMIN_EMAIL="admin@securehub.local"
DEFAULT_ADMIN_EMAIL="<INSERT_ADMIN_EMAIL>"
# For example: DEFAULT_ADMIN_PASSWORD="AdminSecur3#1024!"
DEFAULT_ADMIN_PASSWORD="<INSERT_STRONG_ADMIN_PASSWORD>"

# API Server Ports (HTTPS ONLY - Zero Trust Architecture)
# For example: API_HTTPS_PORT=443
API_HTTPS_PORT=<INSERT_HTTPS_PORT>
